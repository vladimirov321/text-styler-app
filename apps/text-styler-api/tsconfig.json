{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "commonjs",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,

    /* Modules */
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "@/services/*": ["src/services/*"]
    },

    /* Emit */
    "outDir": "./dist",
    "sourceMap": true,

    /* Interop Constraints */
    "allowSyntheticDefaultImports": true,

    /* Completeness */
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/*"
  ]
}